            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": {{leadId}},\n  \"taskType\": \"COURSE_INFORMATION\",\n  \"dueAt\": \"2026-10-29T11:00:00+05:30\",\n  \"timeZone\": \"Asia/Kolkata\",\n  \"reason\": \"Student requested time to review course information\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-admission/sessions/{{sessionId}}/create-follow-up", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "sessions", "{{sessionId}}", "create-follow-up"] }
