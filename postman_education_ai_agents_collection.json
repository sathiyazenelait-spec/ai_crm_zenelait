    {
      "name": "Part 2 — AI Follow-up Agent (28 APIs)",
      "item": [
        {
          "name": "01. Get Follow-up Config",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/education/ai-follow-ups/config", "host": ["{{baseUrl}}"], "path": ["education", "ai-follow-ups", "config"] }
          }
        },
        {
          "name": "02. Update Follow-up Config",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"defaultChannel\": \"EMAIL\",\n  \"humanApprovalRequired\": true,\n  \"respectContactPreferences\": true,\n  \"stopAfterStudentReply\": true,\n  \"maxAutomatedMessagesPerLeadPerWeek\": 3,\n  \"minimumHoursBetweenMessages\": 24,\n  \"permittedContactHours\": {\n    \"start\": \"09:00\",\n    \"end\": \"18:00\",\n    \"timeZone\": \"Asia/Kolkata\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-follow-ups/config", "host": ["{{baseUrl}}"], "path": ["education", "ai-follow-ups", "config"] }
          }
        },
        {
          "name": "03. List Follow-up Rules",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/education/ai-follow-ups/rules?status=ACTIVE&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["education", "ai-follow-ups", "rules"], "query": [{ "key": "status", "value": "ACTIVE" }, { "key": "page", "value": "0" }, { "key": "size", "value": "20" }] }
          }
        },
        {
          "name": "04. Create Follow-up Rule",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Admission Enquiry Follow-up\",\n  \"triggerType\": \"ENQUIRY_CREATED\",\n  \"delayMinutes\": 1440,\n  \"channel\": \"EMAIL\",\n  \"conditions\": {\n    \"leadStatusIn\": [\"NEW\", \"CONTACTED\"],\n    \"marketingConsentRequired\": true,\n    \"stopIfApplicationSubmitted\": true,\n    \"stopIfStudentReplies\": true\n  },\n  \"messageTemplateId\": \"EDU_ADMISSION_FOLLOWUP_01\",\n  \"requiresApproval\": true,\n  \"maxExecutionsPerLead\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-follow-ups/rules", "host": ["{{baseUrl}}"], "path": ["education", "ai-follow-ups", "rules"] }
          }
        },
        {
          "name": "05. Retrieve Follow-up Rule",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/education/ai-follow-ups/rules/{{ruleId}}", "host": ["{{baseUrl}}"], "path": ["education", "ai-follow-ups", "rules", "{{ruleId}}"] }
          }
        },
        {
          "name": "06. Update Follow-up Rule",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delayMinutes\": 2880,\n  \"channel\": \"EMAIL\",\n  \"requiresApproval\": true,\n  \"maxExecutionsPerLead\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-follow-ups/rules/{{ruleId}}", "host": ["{{baseUrl}}"], "path": ["education", "ai-follow-ups", "rules", "{{ruleId}}"] }
          }
