            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmation\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-follow-ups/rules/{{ruleId}}/activate", "host": ["{{baseUrl}}"], "path": ["education", "ai-follow-ups", "rules", "{{ruleId}}", "activate"] }
          }
