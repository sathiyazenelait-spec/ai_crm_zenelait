  "item": [
    {
      "name": "Part 1 — AI Admission Agent (27 APIs)",
      "item": [
        {
          "name": "01. Get Agent Config",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/education/ai-admission/config", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "config"] }
          }
        },
        {
          "name": "02. Update Agent Config",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"supportedChannels\": [\"WEBSITE_CHAT\", \"WHATSAPP\"],\n  \"supportedLanguages\": [\"en\", \"ta\"],\n  \"requireHumanApprovalForOutboundMessages\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-admission/config", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "config"] }
          }
        },
        {
          "name": "03. Start Student Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"WEBSITE_CHAT\",\n  \"language\": \"en\",\n  \"visitor\": {\n    \"name\": \"Arun Kumar\",\n    \"email\": \"arun@example.com\",\n    \"phone\": \"+919876543210\"\n  },\n  \"initialMessage\": \"I want to learn Java Full Stack Development.\",\n  \"consent\": {\n    \"conversationProcessing\": true,\n    \"marketingFollowUps\": false\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-admission/sessions", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "sessions"] }
          }
        },
        {
          "name": "04. List Admission Sessions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/education/ai-admission/sessions?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "sessions"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] }
          }
        },
        {
          "name": "05. Get Session Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/education/ai-admission/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "sessions", "{{sessionId}}"] }
          }
        },
        {
          "name": "06. Send Message to Agent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is the duration and fee of the Java Full Stack course?\",\n  \"messageId\": \"client_msg_1001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-admission/sessions/{{sessionId}}/messages", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "sessions", "{{sessionId}}", "messages"] }
          }
        },
        {
          "name": "07. Retrieve Conversation History",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/education/ai-admission/sessions/{{sessionId}}/messages?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "sessions", "{{sessionId}}", "messages"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] }
          }
        },
        {
          "name": "08. Qualify Prospective Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"educationLevel\": \"BSC\",\n  \"programmingExperience\": \"BEGINNER\",\n  \"interestedCourseId\": 501,\n  \"preferredLearningMode\": \"WEEKEND\",\n  \"expectedJoiningDate\": \"2026-11-15\",\n  \"qualificationAnswers\": {\n    \"careerGoal\": \"Become a Java developer\",\n    \"preferredDuration\": \"ABOUT_SIX_MONTHS\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-admission/sessions/{{sessionId}}/qualify", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "sessions", "{{sessionId}}", "qualify"] }
          }
        },
