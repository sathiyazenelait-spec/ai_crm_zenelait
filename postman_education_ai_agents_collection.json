            "url": { "raw": "{{baseUrl}}/education/ai-admission/sessions/{{sessionId}}/handoff", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "sessions", "{{sessionId}}", "handoff"] }
          }
