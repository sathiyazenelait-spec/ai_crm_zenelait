              "mode": "raw",
              "raw": "{\n  \"leadId\": {{leadId}},\n  \"preferredDate\": \"2026-10-30\",\n  \"preferredTime\": \"11:00\",\n  \"timeZone\": \"Asia/Kolkata\",\n  \"meetingMode\": \"ONLINE\",\n  \"reason\": \"Course and career guidance\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-admission/sessions/{{sessionId}}/schedule-counselling", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "sessions", "{{sessionId}}", "schedule-counselling"] }
          }
        },
