            "url": { "raw": "{{baseUrl}}/education/ai-follow-ups/rules/{{ruleId}}/pause", "host": ["{{baseUrl}}"], "path": ["education", "ai-follow-ups", "rules", "{{ruleId}}", "pause"] }
