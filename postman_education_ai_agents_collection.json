            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"STUDENT_REQUESTED_HUMAN\",\n  \"summary\": \"Student wants to discuss course fee and eligibility with admission executive\",\n  \"preferredTeam\": \"ADMISSIONS\"\n}"
