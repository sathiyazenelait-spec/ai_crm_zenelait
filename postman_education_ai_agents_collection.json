          "name": "09. Recommend Courses",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"educationLevel\": \"BSC\",\n  \"interests\": [\"JAVA\", \"BACKEND_DEVELOPMENT\", \"WEB_DEVELOPMENT\"],\n  \"preferredLearningMode\": \"WEEKEND\",\n  \"maxDurationWeeks\": 30,\n  \"budget\": { \"amount\": 35000, \"currency\": \"INR\" }\n}"
            },
            "url": { "raw": "{{baseUrl}}/education/ai-admission/course-recommendations", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "course-recommendations"] }
          }
        },
        {
          "name": "10. Search Published Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/education/ai-admission/courses?search=Java&learningMode=WEEKEND&page=0&size=10", "host": ["{{baseUrl}}"], "path": ["education", "ai-admission", "courses"], "query": [{ "key": "search", "value": "Java" }, { "key": "learningMode", "value": "WEEKEND" }, { "key": "page", "value": "0" }, { "key": "size", "value": "10" }] }
