              }
            }
          ]
        },
        {
          "name": "Lead Discovery & Qualification",
          "item": [
            {
              "name": "List Leads",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads"
              }
            },
            {
              "name": "Create Lead From Enquiry",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"source\": \"WEBSITE_CHAT\",\n  \"customer\": {\n    \"name\": \"Arun Kumar\",\n    \"email\": \"arun@example.com\",\n    \"phone\": \"+919876543210\"\n  },\n  \"message\": \"I want a five-day Bali trip for two adults in December.\",\n  \"preferredLanguage\": \"en\",\n  \"communicationConsent\": {\n    \"channel\": \"EMAIL\",\n    \"status\": \"GRANTED\",\n    \"capturedAt\": \"2026-10-28T10:00:00Z\",\n    \"source\": \"WEBSITE_FORM\"\n  }\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads"
              }
            },
            {
              "name": "Get Lead By ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}"
              }
            },
            {
              "name": "Qualify Lead",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{}" },
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/qualify"
              }
            },
            {
              "name": "Classify Lead Intent",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{}" },
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/classify"
              }
            },
            {
              "name": "Extract Requirements from Enquiry Message",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"message\": \"We are two adults planning a five-day Bali trip in December. Our total budget is around INR 100000.\",\n  \"language\": \"en\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/extract-requirements"
              }
            },
            {
              "name": "Handoff Lead to Human Sales Representative",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"CUSTOMER_REQUESTED_HUMAN\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/handoff-to-human"
              }
            }
          ]
        },
        {
          "name": "Customer Travel Requirements",
          "item": [
            {
              "name": "Get Travel Requirements",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/requirements"
              }
            },
            {
              "name": "Validate Requirements",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"requirementVersion\": 1\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/requirements/validate"
              }
            },
            {
              "name": "Generate Clarification Questions for Missing Info",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/requirements/questions"
              }
            }
          ]
        },
        {
          "name": "Destination & Product Discovery",
          "item": [
            {
              "name": "Get Destinations",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/destinations"
              }
            },
            {
              "name": "Get Packages",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/packages"
              }
            },
            {
              "name": "Search Connected Travel Inventory",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"destination\": \"Bali\",\n  \"departureCity\": \"Chennai\",\n  \"departureDate\": \"2026-12-10\",\n  \"returnDate\": \"2026-12-15\",\n  \"travellers\": {\n    \"adults\": 2,\n    \"children\": 0\n  },\n  \"budget\": {\n    \"amount\": 100000,\n    \"currency\": \"INR\"\n  },\n  \"components\": [\n    \"FLIGHT\",\n    \"HOTEL\",\n    \"TRANSFER\",\n    \"ACTIVITY\"\n  ]\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/travel-search"
              }
            },
            {
              "name": "Get Travel Search Results",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/travel-search/search_travel_5001"
              }
            },
            {
              "name": "Get Suppliers",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/suppliers"
              }
            }
          ]
        },
        {
          "name": "Recommendations & Itinerary Lifecycle",
          "item": [
            {
              "name": "Generate AI Recommendations",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"searchId\": \"search_travel_5001\",\n  \"preferences\": {\n    \"travelStyle\": \"RELAXED\",\n    \"accommodation\": \"FOUR_STAR\",\n    \"priority\": [\n      \"BUDGET\",\n      \"BEACH\",\n      \"CULTURAL_ACTIVITIES\"\n    ]\n  }\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/recommendations"
              }
            },
            {
              "name": "Create Draft Itinerary",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"recommendationId\": \"rec_travel_1001\",\n  \"title\": \"Bali Five-Day Holiday\",\n  \"currency\": \"INR\",\n  \"days\": [\n    {\n      \"dayNumber\": 1,\n      \"title\": \"Arrival and hotel check-in\",\n      \"items\": []\n    },\n    {\n      \"dayNumber\": 2,\n      \"title\": \"Beach and local sightseeing\",\n      \"items\": []\n    }\n  ]\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/itineraries"
              }
            },
            {
              "name": "Validate Itinerary",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"checkSupplierAvailability\": true,\n  \"checkDateConflicts\": true,\n  \"checkPriceFreshness\": true\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/itineraries/{{itineraryId}}/validate"
              }
            },
            {
              "name": "Explain Itinerary Recommendation",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/itineraries/{{itineraryId}}/explain"
              }
            }
          ]
        },
        {
          "name": "Quotations & Approvals",
          "item": [
            {
              "name": "Create Draft Quotation",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"itineraryId\": \"{{itineraryId}}\",\n  \"currency\": \"INR\",\n  \"items\": [\n    {\n      \"description\": \"Hotel accommodation\",\n      \"productReference\": \"supplier_product_101\",\n      \"quantity\": 1,\n      \"unitPrice\": 32000\n    }\n  ],\n  \"validUntil\": \"2026-11-05T23:59:59Z\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/quotations"
              }
            },
            {
              "name": "Recalculate Quotation",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshSupplierPrices\": true,\n  \"applyApprovedDiscountsOnly\": true\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/quotations/{{quotationId}}/recalculate"
              }
            },
            {
              "name": "Request Quotation Approval",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"Quotation requires review of pricing and missing components.\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/quotations/{{quotationId}}/request-approval"
              }
            },
            {
              "name": "Send Quotation (Expected Block if Unapproved - 409)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"channel\": \"EMAIL\",\n  \"templateId\": \"travel_quote_template_v1\",\n  \"idempotencyKey\": \"send-quote-lead-1001-v1\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/quotations/{{quotationId}}/send"
              }
            },
            {
              "name": "Record Customer Acceptance",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"response\": \"ACCEPTED\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/quotations/{{quotationId}}/record-customer-response"
              }
            }
          ]
        },
        {
          "name": "Booking Handoff & Integrations",
          "item": [
            {
              "name": "Create Booking Handoff",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"quotationId\": \"{{quotationId}}\",\n  \"itineraryId\": \"{{itineraryId}}\",\n  \"customerAcceptanceReference\": \"customer-acceptance-reference\",\n  \"notes\": \"Proceed after booking-readiness validation.\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/booking-handoffs"
              }
            },
            {
              "name": "Get Booking Handoff Status",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-sales-agent/booking-handoffs/{{handoffId}}"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. AI Follow-up Agent",
      "item": [
        {
          "name": "Dashboard & Configuration",
          "item": [
            {
              "name": "Get Follow-up Dashboard",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/dashboard"
              }
            },
            {
              "name": "Get Follow-up Settings",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/settings"
              }
            },
            {
              "name": "Update Follow-up Settings (Quiet Hours)",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"quietHoursStart\": \"21:00\",\n  \"quietHoursEnd\": \"08:00\",\n  \"maxMessagesPerLeadPerWeek\": 3\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/settings"
              }
            },
            {
              "name": "Check Readiness",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/health"
              }
            }
          ]
        },
        {
          "name": "Automation Plans & Tasks",
          "item": [
            {
              "name": "Create Follow-up Plan",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Travel quotation follow-up\",\n  \"trigger\": {\n    \"event\": \"TRAVEL_QUOTATION_SENT\"\n  },\n  \"steps\": [\n    {\n      \"delayMinutes\": 1440,\n      \"channel\": \"EMAIL\",\n      \"templateId\": \"travel_quote_followup_v1\"\n    },\n    {\n      \"delayMinutes\": 4320,\n      \"channel\": \"EMAIL\",\n      \"templateId\": \"travel_quote_followup_v2\"\n    }\n  ],\n  \"rules\": {\n    \"stopOnCustomerReply\": true,\n    \"stopOnQuotationAccepted\": true,\n    \"stopOnOptOut\": true,\n    \"requireConsent\": true,\n    \"maxMessagesPerLeadPerWeek\": 3,\n    \"requireHumanApproval\": true\n  }\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/plans"
              }
            },
            {
              "name": "Preview Follow-up Plan Simulation",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"quotationId\": \"{{quotationId}}\",\n  \"referenceTime\": \"2026-10-28T10:00:00Z\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/plans/follow_plan_1001/preview"
              }
            },
            {
              "name": "Create Follow-up Task",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"quotationId\": \"{{quotationId}}\",\n  \"reason\": \"QUOTATION_PENDING_RESPONSE\",\n  \"scheduledAt\": \"2026-10-29T10:00:00Z\",\n  \"channel\": \"EMAIL\",\n  \"priority\": \"NORMAL\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/tasks"
              }
            },
            {
              "name": "Draft Follow-up Message",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"tone\": \"FRIENDLY\",\n  \"language\": \"en\",\n  \"purpose\": \"ASK_IF_CUSTOMER_HAS_QUESTIONS\",\n  \"includeQuotationReference\": true\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/tasks/{{taskId}}/draft-message"
              }
            },
            {
              "name": "Approve Message Draft",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"draftId\": \"follow_draft_1001\",\n  \"decision\": \"APPROVE\",\n  \"comment\": \"Approved after reviewing content and communication policy.\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/tasks/{{taskId}}/approve-message"
              }
            },
            {
              "name": "Send Message (Blocked if Consent Missing - 403)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "follow-task-1001-send-v1" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"draftId\": \"follow_draft_1001\",\n  \"channel\": \"EMAIL\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/tasks/{{taskId}}/send"
              }
            }
          ]
        },
