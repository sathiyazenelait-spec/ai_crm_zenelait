              "name": "Record Customer Opt-Out",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"channel\": \"EMAIL\",\n  \"reason\": \"CUSTOMER_REQUEST\",\n  \"source\": \"INBOUND_EMAIL\",\n  \"providerEventId\": \"provider-event-12345\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/customers/CUST-1001/opt-out"
              }
            },
            {
              "name": "Classify Customer Response (Request Lower Price)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"messageId\": \"inbound_msg_1001\",\n  \"text\": \"Can you show me a cheaper package?\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/responses/classify"
              }
            },
            {
              "name": "Escalate to Human Consultant",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"CUSTOMER_REQUESTED_HUMAN_ASSISTANCE\",\n  \"priority\": \"HIGH\",\n  \"summary\": \"Customer requested personal assistance with travel options.\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-follow-up-agent/tasks/{{taskId}}/escalate"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. AI Booking Agent",
      "item": [
        {
          "name": "Dashboard & Readiness Validation",
          "item": [
            {
              "name": "Get Booking Dashboard",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-booking-agent/dashboard"
              }
            },
            {
              "name": "Get Accepted Handoffs",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-booking-agent/handoffs?status=ACCEPTED&page=0&size=20"
              }
            },
            {
              "name": "Validate Booking Readiness (Checks Passenger Details)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"checkAcceptance\": true,\n  \"checkPassengerDetails\": true,\n  \"checkSupplierAvailability\": true,\n  \"checkPriceFreshness\": true,\n  \"checkRequiredApprovals\": true\n}"
                },
                "url": "{{baseUrl}}/travel/ai-booking-agent/handoffs/{{handoffId}}/validate"
              }
            },
            {
              "name": "Return Incomplete Handoff to Sales",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"PASSENGER_DETAILS_INCOMPLETE\",\n  \"message\": \"Please collect missing passport numbers and dates of birth before booking.\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-booking-agent/handoffs/{{handoffId}}/return"
              }
            }
          ]
        },
        {
          "name": "Internal Bookings & Supplier Reservations",
          "item": [
            {
              "name": "Create Internal Booking Record",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "booking-handoff-1001-v1" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"handoffId\": \"{{handoffId}}\",\n  \"quotationId\": \"{{quotationId}}\",\n  \"itineraryId\": \"{{itineraryId}}\",\n  \"itineraryVersion\": 1,\n  \"currency\": \"INR\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-booking-agent/bookings"
              }
            },
            {
              "name": "Start Supplier Verification Search",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"components\": [\n    {\n      \"type\": \"HOTEL\",\n      \"productReference\": \"supplier_product_101\"\n    }\n  ],\n  \"refreshAvailability\": true,\n  \"refreshPricing\": true\n}"
                },
                "url": "{{baseUrl}}/travel/ai-booking-agent/supplier-searches"
              }
            },
            {
              "name": "Submit Supplier Reservation",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "booking-2001-hotel-reservation-v1" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"productReference\": \"supplier_product_101\",\n  \"supplierReference\": \"supplier-ref-101\",\n  \"serviceType\": \"HOTEL\",\n  \"travellerCount\": {\n    \"adults\": 2,\n    \"children\": 0\n  },\n  \"customerAcceptanceReference\": \"verified-acceptance-record\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-booking-agent/bookings/{{bookingId}}/supplier-reservations"
              }
            },
            {
              "name": "Get Supplier Reservation Status",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-booking-agent/supplier-reservations/{{reservationId}}/status"
              }
            },
            {
              "name": "Reconcile Uncertain Supplier Status",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-booking-agent/supplier-reservations/{{reservationId}}/reconcile"
              }
            }
          ]
        },
        {
          "name": "Payments, Vouchers & Cancellations",
          "item": [
            {
              "name": "Create Payment Checkout Session",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "booking-2001-checkout-v1" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 32000,\n  \"currency\": \"INR\",\n  \"paymentPurpose\": \"TRAVEL_BOOKING\",\n  \"returnUrl\": \"https://your-frontend.example.com/travel/payment-result\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-booking-agent/bookings/{{bookingId}}/checkout-sessions"
              }
            },
            {
              "name": "Check Authoritative Payment Status",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/travel/ai-booking-agent/payments/payment_travel_2001/status"
              }
            },
            {
              "name": "Generate Official Voucher (Blocked if Unconfirmed - 409)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reservationId\": \"unconfirmed_res_999\",\n  \"documentType\": \"HOTEL_VOUCHER\",\n  \"deliveryChannel\": \"EMAIL\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-booking-agent/bookings/{{bookingId}}/vouchers"
              }
            },
            {
              "name": "Generate Voucher for Confirmed Reservation (201)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reservationId\": \"{{reservationId}}\",\n  \"documentType\": \"HOTEL_VOUCHER\",\n  \"deliveryChannel\": \"EMAIL\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-booking-agent/bookings/{{bookingId}}/vouchers"
              }
            },
            {
              "name": "Submit Cancellation Request",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"CUSTOMER_REQUEST\",\n  \"reservationIds\": [\n    \"{{reservationId}}\"\n  ],\n  \"customerRequestReference\": \"customer-cancellation-request-2001\"\n}"
                },
                "url": "{{baseUrl}}/travel/ai-booking-agent/bookings/{{bookingId}}/cancellation-requests"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. End-to-End Autonomous Agent Journey",
      "item": [
        {
          "name": "1. Customer Enquiry Received -> Sales Agent Creates Lead",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"WEBSITE_CHAT\",\n  \"customer\": {\n    \"name\": \"Arun Kumar\",\n    \"email\": \"arun@example.com\",\n    \"phone\": \"+919876543210\"\n  },\n  \"message\": \"I want a five-day Bali holiday for two adults in December, budget INR 100000.\",\n  \"communicationConsent\": {\n    \"channel\": \"EMAIL\",\n    \"status\": \"GRANTED\",\n    \"capturedAt\": \"2026-10-28T10:00:00Z\"\n  }\n}"
            },
            "url": "{{baseUrl}}/travel/ai-sales-agent/leads"
          }
        },
        {
          "name": "2. Sales Agent Extracts Requirements & Questions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Two adults, five-day Bali trip in December, total budget INR 100000.\"\n}"
            },
            "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/extract-requirements"
          }
        },
        {
          "name": "3. Search Verified Supplier Products",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"Bali\",\n  \"departureCity\": \"Chennai\",\n  \"departureDate\": \"2026-12-10\",\n  \"returnDate\": \"2026-12-15\",\n  \"travellers\": { \"adults\": 2, \"children\": 0 },\n  \"budget\": { \"amount\": 100000, \"currency\": \"INR\" }\n}"
            },
            "url": "{{baseUrl}}/travel/ai-sales-agent/travel-search"
          }
        },
        {
          "name": "4. Create Grounded Recommendation & Itinerary",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"title\": \"Bali Five-Day Holiday\",\n  \"currency\": \"INR\"\n}"
            },
            "url": "{{baseUrl}}/travel/ai-sales-agent/itineraries"
          }
        },
        {
          "name": "5. Calculate Server-Side Quotation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"itineraryId\": \"{{itineraryId}}\",\n  \"currency\": \"INR\",\n  \"items\": [\n    { \"description\": \"Hotel accommodation\", \"productReference\": \"supplier_product_101\", \"quantity\": 1, \"unitPrice\": 32000 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/travel/ai-sales-agent/quotations"
          }
        },
        {
          "name": "6. Follow-up Agent Schedules Cadence on Event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"TRAVEL_QUOTATION_SENT\",\n  \"leadId\": \"{{leadId}}\",\n  \"quotationId\": \"{{quotationId}}\"\n}"
            },
            "url": "{{baseUrl}}/travel/ai-follow-up-agent/events"
          }
        },
        {
          "name": "7. Customer Accepts Quotation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": \"ACCEPTED\"\n}"
            },
            "url": "{{baseUrl}}/travel/ai-sales-agent/quotations/{{quotationId}}/record-customer-response"
          }
        },
        {
          "name": "8. Sales Agent Hands Off to Booking Agent",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quotationId\": \"{{quotationId}}\",\n  \"itineraryId\": \"{{itineraryId}}\",\n  \"customerAcceptanceReference\": \"verified-acceptance-1001\"\n}"
            },
            "url": "{{baseUrl}}/travel/ai-sales-agent/leads/{{leadId}}/booking-handoffs"
          }
        },
        {
          "name": "9. Booking Agent Validates Readiness & Creates Internal Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "booking-e2e-1001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"handoffId\": \"{{handoffId}}\",\n  \"quotationId\": \"{{quotationId}}\",\n  \"itineraryId\": \"{{itineraryId}}\",\n  \"currency\": \"INR\"\n}"
            },
            "url": "{{baseUrl}}/travel/ai-booking-agent/bookings"
          }
        },
        {
          "name": "10. Booking Agent Submits Reservation & Reconciles with Supplier",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/travel/ai-booking-agent/supplier-reservations/{{reservationId}}/reconcile"
          }
        },
        {
          "name": "11. Booking Agent Generates Official Travel Voucher",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": \"{{reservationId}}\",\n  \"documentType\": \"HOTEL_VOUCHER\",\n  \"deliveryChannel\": \"EMAIL\"\n}"
            },
            "url": "{{baseUrl}}/travel/ai-booking-agent/bookings/{{bookingId}}/vouchers"
          }
        }
      ]
    }
  ]
