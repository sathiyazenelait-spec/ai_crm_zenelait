{
  "info": {
    "_postman_id": "zenelait-master-mysql-crm-2026",
    "name": "Zenelait AI CRM — Master MySQL & 200% Autonomous Fleet Collection",
    "description": "Complete production Postman collection for Zenelait AI Multi-Tenant SaaS CRM backed by MySQL (zenelait_crm_db) and Spring Boot 3.2.3. Includes Auth, Leads, AI Sales Assist, Support Triage, Automated Follow-ups, and all 9 Industry Tenant APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "TEN-IT-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication (MySQL Users)",
      "item": [
        {
          "name": "POST Login (Admin - Returns JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.accessToken);",
                  "    pm.test('Token received and stored in collection variable', function() {",
                  "        pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@abctech.com\",\n  \"password\": \"ExamplePassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "POST Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"rt-example-uuid\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        }
      ]
    },
